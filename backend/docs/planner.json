  "components": {
    "schemas": {
      "CreateEventCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "example": "#6366f1",
            "description": "Hex color code"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "UpdateEventCategoryDto": {
        "type": "object",
        "properties": {}
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "example": "2025-12-31T09:00:00.000Z"
          },
          "endDate": {
            "type": "string",
            "example": "2025-12-31T17:00:00.000Z"
          },
          "isAllDay": {
            "type": "boolean"
          },
          "location": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "description": "Event category UUID"
          },
          "visibilityScope": {
            "type": "string",
            "enum": ["school_wide", "class_level", "subject", "teachers"]
          },
          "targetClassLevelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "targetSubjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reminderTime": {
                  "type": "string",
                  "format": "date-time"
                },
                "notificationType": {
                  "type": "string",
                  "enum": ["email", "sms", "both"]
                }
              }
            }
          },
          "sendNotifications": {
            "type": "boolean"
          }
        },
        "required": ["title", "startDate", "categoryId", "visibilityScope"]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {}
      }
    }
  },
  "tags": []
