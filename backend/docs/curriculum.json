  "components": {
    "schemas": {
      "CreateCurriculumDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "subjectCatalogIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "academicTermId": {
            "type": "string",
            "description": "Academic term UUID — omit for a reusable (term-agnostic) curriculum; subtopic progress stays per term via completions"
          }
        },
        "required": ["name", "subjectCatalogIds"]
      },
      "CreateTopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "number",
            "minimum": 0
          },
          "plannedStartDate": {
            "type": "string",
            "description": "Planned start date (ISO date)"
          },
          "plannedEndDate": {
            "type": "string",
            "description": "Planned end date (ISO date)"
          },
          "subjectCatalogId": {
            "type": "string",
            "description": "Subject catalog UUID"
          },
          "curriculumId": {
            "type": "string",
            "description": "Curriculum UUID"
          },
          "academicTermId": {
            "type": "string",
            "description": "Academic term UUID (must belong to the school)"
          }
        },
        "required": [
          "name",
          "subjectCatalogId",
          "curriculumId",
          "academicTermId"
        ]
      },
      "DuplicateTopicsToTermDto": {
        "type": "object",
        "properties": {
          "sourceAcademicTermId": {
            "type": "string",
            "description": "Academic term to copy topics from"
          },
          "targetAcademicTermId": {
            "type": "string",
            "description": "Academic term to create duplicated topics in"
          },
          "duplicateAllFromSource": {
            "type": "boolean",
            "description": "When true, duplicate every topic whose effective term is the source term. Do not send topicIds."
          },
          "topicIds": {
            "description": "Topic UUIDs to copy. Required unless duplicateAllFromSource is true.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["sourceAcademicTermId", "targetAcademicTermId"]
      },
      "CreateSubtopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "UpdateTopicDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSubtopicDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCurriculumTopicNoteDto": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "description": "Topic UUID"
          },
          "subjectId": {
            "type": "string",
            "description": "Subject UUID - omit for school-wide note"
          },
          "content": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "description": "Parent note UUID for replies"
          },
          "academicTermId": {
            "type": "string",
            "description": "Academic term UUID — scopes the note to a term (recommended when topics are reused across terms)"
          }
        },
        "required": ["topicId", "content"]
      },
      "UpdateCurriculumDto": {
        "type": "object",
        "properties": {
          "academicTermId": {
            "type": "object",
            "nullable": true,
            "description": "Academic term UUID, or null to unlink (term-agnostic curriculum)"
          }
        }
      }
    }
  },
  "tags": []
