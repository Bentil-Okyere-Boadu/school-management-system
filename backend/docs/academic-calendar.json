          },
          "holidays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateHolidayDto"
            }
          }
        },
        "required": ["termName", "startDate", "endDate", "academicCalendarId"]
      },
      "CreateHolidayDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
