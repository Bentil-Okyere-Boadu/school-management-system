    }
  ],
  "paths": {
    "/api/v1/invitations/admin": {
      "post": {
        "operationId": "InvitationController_inviteAdmin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Invitation"]
      }
    },
