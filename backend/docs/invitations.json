            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Invitation"]
      }
    },
    "/api/v1/invitations/teacher/resend/{userId}": {
      "post": {
        "operationId": "InvitationController_resendTeacherInvitation",
        "parameters": [
          {
            "name": "userId",
            "required": true,
