  "components": {
    "schemas": {
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "user@school.com"
          },
          "roleId": {
            "type": "string",
            "description": "Role UUID"
          }
        },
        "required": ["firstName", "lastName", "email", "roleId"]
      },
      "InviteStudentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "student@school.com"
          }
        },
        "required": ["firstName", "lastName", "email"]
      },
      "InviteTeacherDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "teacher@school.com"
          }
        },
        "required": ["firstName", "lastName", "email"]
      },
      "CompleteRegistrationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Registration token from invitation email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": ["token", "password"]
      },
      "ForgotPinDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@school.com"
          }
        },
        "required": ["email"]
      }
    }
  },
  "tags": [
    {
      "name": "invitations"
    }
  ]
}
