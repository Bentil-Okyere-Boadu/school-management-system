  "components": {
    "schemas": {
      "ForgotStudentPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@school.com"
          }
        },
        "required": ["email"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "otherName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "phoneContact": {
            "type": "string"
          },
          "PlaceOfBirth": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female"]
          },
          "DateOfBirth": {
            "type": "string"
          },
          "BoxAddress": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "streetAddress": {
            "type": "string"
          },
          "optionalPhoneContact": {
            "type": "string"
          },
          "optionalPhoneContactTwo": {
            "type": "string"
          }
        }
      },
      "UpdateParentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "parent@example.com"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        }
      },
      "CreateParentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "parent@example.com"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        },
        "required": ["firstName", "lastName", "email"]
      },
      "SubmitAssignmentDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string"
          }
        }
