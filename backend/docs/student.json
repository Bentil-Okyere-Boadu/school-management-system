{
  "openapi": "3.0.0",
  "info": {
    "title": "School Management - Student",
    "description": "OpenAPI spec for Postman and other clients",
    "version": "1.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "API Server"
    }
