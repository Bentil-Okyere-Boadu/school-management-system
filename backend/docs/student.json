  "components": {
    "schemas": {
      "ForgotStudentPasswordDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "ABC-00000-120-00001",
            "description": "Generated studentId, or email only if it belongs to exactly one school"
          }
        },
        "required": ["identifier"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "otherName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "phoneContact": {
            "type": "string"
          },
          "PlaceOfBirth": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female"]
          },
          "DateOfBirth": {
            "type": "string"
          },
          "BoxAddress": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "streetAddress": {
            "type": "string"
          },
          "optionalPhoneContact": {
            "type": "string"
          },
          "optionalPhoneContactTwo": {
            "type": "string"
          }
        }
      },
      "UpdateParentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "parent@example.com"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        }
      },
      "CreateParentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "parent@example.com"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "example": "Mother"
          }
        },
        "required": ["firstName", "lastName", "email", "relationship"]
      },
      "SubmitAssignmentDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": []
