  "paths": {
    "/api/v1/student/login": {
      "post": {
        "operationId": "StudentController_login",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Log in with identifier + PIN. Prefer studentId ABC-00000-120-00001 (school = 5-digit schoolCode). Email is allowed only when tenant_directory has exactly one student row.",
        "tags": ["Student"]
      }
    },
    "/api/v1/student/forgot-password": {
      "post": {
        "operationId": "StudentController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotStudentPasswordDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Reset PIN before login. Same identifier contract as login. Ambiguous email does not mutate any tenant.",
        "tags": ["Student"]
      }
    },
