  "components": {
    "schemas": {
      "HubtelInteractionRequestDto": {
        "type": "object",
        "properties": {
          "Type": {
            "type": "string",
            "enum": ["Initiation", "Response", "Timeout"]
          },
          "Message": {
            "type": "string"
          },
          "ServiceCode": {
            "type": "string"
          },
          "Operator": {
            "type": "string"
          },
          "ClientState": {
            "type": "string"
          },
          "Mobile": {
            "type": "string"
          },
          "SessionId": {
            "type": "string"
          },
          "Sequence": {
            "type": "number"
          },
          "Platform": {
            "type": "string",
            "enum": ["USSD", "Webstore", "Hubtel-App"]
          },
          "MetaData": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "Type",
          "Message",
          "ServiceCode",
          "Operator",
          "ClientState",
          "Mobile",
          "SessionId",
          "Sequence",
          "Platform"
        ]
      },
      "HubtelReceiveMoneyCallbackDto": {
        "type": "object",
        "properties": {
          "ResponseCode": {
            "type": "string",
            "description": "Hubtel response code (e.g. 0000, 2001)"
          },
          "Message": {
            "type": "string"
          },
          "Data": {
            "$ref": "#/components/schemas/HubtelReceiveMoneyCallbackDataDto"
          }
        },
        "required": ["ResponseCode", "Data"]
      },
      "HubtelReceiveMoneyCallbackDataDto": {
        "type": "object",
        "properties": {
          "Amount": {
            "type": "number"
          },
          "Charges": {
            "type": "number"
          },
          "AmountAfterCharges": {
            "type": "number"
          },
          "AmountCharged": {
            "type": "number"
          },
          "Description": {
            "type": "string"
          },
          "ClientReference": {
            "type": "string"
          },
          "TransactionId": {
            "type": "string"
          },
          "ExternalTransactionId": {
            "type": "string"
          },
          "OrderId": {
            "type": "string"
          },
          "PaymentDate": {
            "type": "string"
          }
        },
        "required": [
          "Amount",
          "Charges",
          "AmountAfterCharges",
          "ClientReference",
          "TransactionId"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "integrations"
    }
  ]
