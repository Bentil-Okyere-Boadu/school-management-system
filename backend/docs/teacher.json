    "/api/v1/teacher/students/{studentId}/performance-analytics": {
      "get": {
        "description": "Returns subject → topic → assignment breakdown of a student's graded submissions for a given academic term, restricted to subjects the teacher teaches for that student (class teachers still only see subjects they teach in this assignment-level endpoint).",
        "operationId": "StudentAnalyticsTeacherController_getPerformanceAnalytics",
        "parameters": [
          {
            "name": "studentId",
            "required": true,
            "in": "path",
            "description": "UUID of the student",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "academicTermId",
            "required": true,
            "in": "query",
            "description": "UUID of the academic term",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get assignment-level performance analytics for a student",
        "tags": ["Teacher"]
      }
    },
    "/api/v1/teacher/students/{studentId}/topic-performance": {
      "get": {
        "description": "Teacher-scoped mirror of the school-admin topic-performance endpoint. Class teachers of an overlapping class may query any subject; subject teachers may only query subjects they teach in an overlapping class. Used for the student detail page in Performance Breakdown.",
        "operationId": "StudentAnalyticsTeacherController_getTopicPerformance",
        "parameters": [
          {
            "name": "studentId",
            "required": true,
            "in": "path",
            "description": "UUID of the student",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "academicTermId",
            "required": true,
            "in": "query",
            "description": "UUID of the academic term",
