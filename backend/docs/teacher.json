  "components": {
    "schemas": {
      "ForgotTeacherPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "teacher@school.com"
          }
        },
        "required": ["email"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "otherName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "phoneContact": {
            "type": "string"
          },
          "PlaceOfBirth": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female"]
          },
          "DateOfBirth": {
            "type": "string"
          },
          "BoxAddress": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "streetAddress": {
            "type": "string"
          },
          "optionalPhoneContact": {
            "type": "string"
          },
          "optionalPhoneContactTwo": {
            "type": "string"
          }
        }
      },
      "CreateTeacherTopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "plannedStartDate": {
            "type": "string"
          },
          "plannedEndDate": {
            "type": "string"
          },
          "subjectCatalogId": {
            "type": "string",
            "description": "Subject catalog UUID"
          },
          "academicTermId": {
            "type": "string",
            "description": "Academic term UUID (must belong to the school)"
          }
        },
        "required": ["name", "subjectCatalogId", "academicTermId"]
      },
      "UpdateTeacherTopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "plannedStartDate": {
            "type": "string"
          },
          "plannedEndDate": {
            "type": "string"
          },
          "subjectCatalogId": {
            "type": "string",
            "description": "Subject catalog UUID"
          }
        }
      },
      "CreateSubtopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "UpdateSubtopicDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCurriculumTopicNoteDto": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "description": "Topic UUID"
          },
          "subjectId": {
            "type": "string",
            "description": "Subject UUID - omit for school-wide note"
          },
          "content": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "description": "Parent note UUID for replies"
          },
          "academicTermId": {
            "type": "string",
            "description": "Academic term UUID — scopes the note to a term (recommended when topics are reused across terms)"
          }
        },
        "required": ["topicId", "content"]
      },
      "CreateAssignmentDto": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "description": "Topic UUID"
          },
          "classLevelId": {
            "type": "string",
            "description": "Class level UUID"
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "example": "2025-12-31T23:59:59.000Z",
            "description": "Due date (ISO 8601)"
          },
          "maxScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "state": {
            "type": "string",
            "enum": ["draft", "published"]
          },
          "assignmentType": {
            "type": "string",
            "enum": ["online", "offline"]
          }
        },
        "required": [
          "topicId",
          "classLevelId",
          "title",
          "dueDate",
          "maxScore",
          "state"
        ]
      },
      "UpdateAssignmentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "dueDate": {
