        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "admin@school.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": ["firstName", "lastName", "email", "password"]
      }
    }
