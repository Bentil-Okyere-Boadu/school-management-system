  "components": {
    "schemas": {
      "CreateSchoolDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "school@example.com"
          },
          "calendlyUrl": {
            "type": "string",
            "example": "https://calendly.com/school"
          }
        },
        "required": ["name", "calendlyUrl"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "otherName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "phoneContact": {
            "type": "string"
          },
          "PlaceOfBirth": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female"]
          },
          "DateOfBirth": {
            "type": "string"
          },
          "BoxAddress": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "streetAddress": {
            "type": "string"
          },
          "optionalPhoneContact": {
            "type": "string"
          },
          "optionalPhoneContactTwo": {
            "type": "string"
          }
        }
      },
