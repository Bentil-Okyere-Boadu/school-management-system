  "components": {
    "schemas": {
      "CreateNotificationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "admission",
              "attendance",
              "results",
              "fee",
              "general",
              "classTeacherResultSubmission",
              "parentInvitation",
              "parentAccepted",
              "parentChildConfirmation",
              "parentChildConfirmed",
              "parentReviewRequired",
              "parentAccessRevoked",
              "assignmentPublished",
              "assignmentUpdated",
              "assignmentSubmitted",
              "assignmentGraded",
              "curriculumNote",
              "curriculumNoteReply",
              "gradesSubmitted",
              "classResultsSubmitted",
              "resultsReleased",
              "resultsUnlocked"
            ]
          },
          "message": {
            "type": "string"
          },
          "schoolId": {
            "type": "string",
            "description": "School UUID"
          }
        },
        "required": ["title", "type", "message", "schoolId"]
      },
      "UpdateNotificationDto": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean"
          }
        }
      }
