  "components": {
    "schemas": {
      "CreateGradingSystemDto": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string",
            "example": "A"
          },
          "minRange": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "maxRange": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["grade", "minRange", "maxRange"]
      },
      "UpdateGradingSystemDto": {
        "type": "object",
        "properties": {}
      }
