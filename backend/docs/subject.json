  "components": {
    "schemas": {
      "CreateSubjectDto": {
        "type": "object",
        "properties": {
          "subjectCatalogId": {
            "type": "string",
            "description": "Subject catalog UUID"
          },
          "classLevelIds": {
            "description": "Class level UUIDs",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "teacherId": {
            "type": "string",
            "description": "Teacher UUID"
          }
        },
        "required": ["subjectCatalogId", "classLevelIds", "teacherId"]
      },
      "UpdateSubjectDto": {
        "type": "object",
        "properties": {
          "subjectCatalogId": {
            "type": "string",
            "description": "Subject catalog UUID"
          },
          "classLevelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "teacherId": {
            "type": "string",
            "description": "Teacher UUID"
          }
        }
      },
      "AdminResultActionDto": {
        "type": "object",
        "properties": {
          "classLevelId": {
            "type": "string"
          },
          "academicTermId": {
            "type": "string"
          }
        },
        "required": ["classLevelId", "academicTermId"]
      },
      "AdminReturnResultsDto": {
        "type": "object",
        "properties": {
          "classLevelId": {
            "type": "string"
          },
          "academicTermId": {
            "type": "string"
          },
          "returnNote": {
            "type": "string"
          }
        },
        "required": ["classLevelId", "academicTermId", "returnNote"]
      },
      "SubmitTermRemarksDto": {
        "type": "object",
        "properties": {
          "remarks": {
            "type": "string"
          }
        },
        "required": ["remarks"]
      },
      "SubmitGradesDto": {
        "type": "object",
        "properties": {
          "classLevelId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "academicTermId": {
            "type": "string"
          },
          "saveMode": {
            "type": "string",
            "enum": ["draft", "submit"]
          },
          "forceSubmit": {
            "type": "boolean",
            "description": "When true, submit even if some students have missing scores"
          },
          "grades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmitGradeEntryDto"
            }
          }
        },
        "required": [
          "classLevelId",
          "subjectId",
          "academicTermId",
          "saveMode",
          "grades"
        ]
      },
      "SubmitGradeEntryDto": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string"
          },
          "classScore": {
            "type": "object",
            "description": "Omit or null when score not entered yet"
          },
          "examScore": {
            "type": "object",
            "description": "Omit or null when score not entered yet"
          },
          "feedback": {
            "type": "object"
          },
          "overrideGrade": {
            "type": "object",
            "description": "Manual grade override when enabled by school"
          },
          "overrideReason": {
            "type": "object",
            "description": "Required when overrideGrade is set"
          }
        },
        "required": ["studentId"]
      }
    }
  },
  "tags": []
}
